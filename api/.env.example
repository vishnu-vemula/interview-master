# =============================================
# InterviewMaster - Backend Environment Variables
# =============================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB (current application data store)
MONGO_URI=mongodb://127.0.0.1:27017/interviewmaster

# PostgreSQL target for the Prisma cutover (not yet used by the running API)
DATABASE_URL=postgresql://interviewmaster:replace_me@127.0.0.1:5432/interviewmaster

# Firebase Auth demo project works with the local emulator. In production, use
# the real project ID and Application Default Credentials/service account.
AUTH_PROVIDER=legacy
FIREBASE_PROJECT_ID=demo-interviewmaster
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# JWT
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_refresh_token_secret_min_32_chars
JWT_REFRESH_EXPIRE=30d

# Groq AI (Free LLM API - https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Required for RAG (Converting Resumes & JDs to Vector Embeddings)
OPENAI_API_KEY=your_actual_openai_api_key_here

# Cloudinary (Resume/File Storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Frontend URL (CORS)
CLIENT_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:5000

# PayU India hosted checkout. Set PAYU_ENV=test for sandbox.
PAYU_ENV=test
PAYU_MERCHANT_KEY=replace_with_test_merchant_key
PAYU_MERCHANT_SALT=replace_with_test_merchant_salt

# Redis is required in production; it may be disabled for a limited local smoke test.
REDIS_URL=redis://127.0.0.1:6379
REDIS_ENABLED=true

# Only for the one-time administrative bootstrap command; remove after use.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace_with_a_unique_16_character_password

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Account recovery + social sign-in (JWT auth mode) ────────────
# Password-reset emails via the Resend HTTP API. Without these, non-production
# servers print the reset link to the API log instead of emailing it.
RESEND_API_KEY=
EMAIL_FROM="Rehearsly <no-reply@your-domain.com>"
# OAuth apps — redirect URI: ${API_PUBLIC_URL}/api/auth/oauth/<google|linkedin>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
