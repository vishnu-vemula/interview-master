# =============================================
# InterviewMaster - Backend Environment Variables
# =============================================

# Server
PORT=5000
NODE_ENV=development

# Application database. Require TLS (sslmode=require or verify-full) in production.
DATABASE_URL=postgresql://interviewmaster:replace_me@127.0.0.1:5432/interviewmaster

# Firebase Auth. In production use Application Default Credentials and omit emulator host.
FIREBASE_PROJECT_ID=demo-interviewmaster
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Groq AI (Free LLM API - https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Required for RAG (Converting Resumes & JDs to Vector Embeddings)
OPENAI_API_KEY=your_actual_openai_api_key_here

# Cloudinary (Resume/File Storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Frontend URL (CORS)
CLIENT_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:5000

# PayU India hosted checkout. Set PAYU_ENV=test for sandbox.
PAYU_ENV=test
PAYU_MERCHANT_KEY=replace_with_test_merchant_key
PAYU_MERCHANT_SALT=replace_with_test_merchant_salt

# Adzuna job sync. Omit both to disable scheduled external sync.
# ADZUNA_APP_ID=replace_with_adzuna_app_id
# ADZUNA_APP_KEY=replace_with_adzuna_app_key

# Redis is required in production; it may be disabled for a limited local smoke test.
REDIS_URL=redis://127.0.0.1:6379
REDIS_ENABLED=true

# Only for the one-time administrative bootstrap command; remove after use.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_FIREBASE_UID=replace_with_existing_verified_firebase_uid

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Migration only: point these at a frozen copy of the legacy databases.
# MONGO_URI=mongodb://127.0.0.1:27017/interviewmaster_legacy_snapshot
# LEGACY_JOBS_DATABASE_URL=postgresql://.../legacy_jobs_snapshot
