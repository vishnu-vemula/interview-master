generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  candidate
  support
  content_manager
  admin
  super_admin
}

enum UserStatus {
  active
  disabled
  banned
  deleting
  deleted
}

enum ParseStatus {
  pending
  parsed
  failed
}

enum GenerationStatus {
  pending
  generating
  generated
  failed
}

enum InterviewStatus {
  draft
  ready
  in_progress
  completed
}

enum SessionStatus {
  started
  in_progress
  evaluating
  evaluation_failed
  completed
  abandoned
}

enum EvaluationStatus {
  pending
  evaluating
  completed
  unavailable
}

enum BillingInterval {
  one_time
  monthly
  yearly
}

enum SubscriptionStatus {
  active
  canceled
  refunded
  expired
  past_due
}

enum PaymentStatus {
  pending
  success
  failed
  refund_pending
  refunded
}

enum EventStatus {
  received
  processed
  failed
}

enum JobState {
  queued
  running
  succeeded
  failed
  canceled
}

model User {
  id              String             @id @default(uuid()) @db.Uuid
  firebaseUid     String             @unique
  email           String             @unique
  displayName     String
  avatar          String?
  credits         Int                @default(10)
  isPremium       Boolean            @default(false)
  lastLogin       DateTime?
  totalSessions   Int                @default(0)
  role            UserRole           @default(candidate)
  status          UserStatus         @default(active)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deletedAt       DateTime?
  resumes         Resume[]
  interviews      Interview[]
  sessions        Session[]
  subscriptions   Subscription[]
  usageLedger     UsageLedgerEntry[]
  auditEvents     AuditEvent[]       @relation("AuditActor")
  billingCustomer BillingCustomer?
  paymentOrders   PaymentOrder[]
  backgroundJobs  BackgroundJob[]
  postedJobs      JobListing[]       @relation("JobPoster")
  postedPlans     Plan[]             @relation("PlanPoster")
  templates       InterviewTemplate[]
  promptEdits     SystemPrompt[]     @relation("PromptEditor")
  transactions    LegacyTransaction[]
  usageCounters   UsageCounter[]

  @@index([status, createdAt])
}

model Resume {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @db.Uuid
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  storageKey    String        @unique
  originalName  String
  fileName      String?
  format        String              @default("pdf")
  deliveryType  String              @default("authenticated")
  legacyFileUrl String?
  contentType   String
  sizeBytes     Int
  parseStatus   ParseStatus   @default(pending)
  extractedText String?
  parsedData    Json?
  isParsed      Boolean       @default(false)
  isDefault     Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?
  chunks        ResumeChunk[]
  interviews    Interview[]

  @@index([userId, deletedAt, createdAt])
  @@unique([id, userId])
}

model ResumeChunk {
  id               String   @id @default(uuid()) @db.Uuid
  resumeId         String   @db.Uuid
  resume           Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  ordinal          Int
  section          String?
  text             String
  embeddingStatus  String   @default("not_requested")
  embeddingModel   String?
  embeddingVersion String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([resumeId, ordinal])
}

model Interview {
  id               String             @id @default(uuid()) @db.Uuid
  userId           String             @db.Uuid
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeId         String?            @db.Uuid
  resume           Resume?            @relation(fields: [resumeId, userId], references: [id, userId], onDelete: Restrict)
  resumeSnapshot   Json?
  jobTitle         String
  company          String?
  jobDescription   String
  experienceLevel  String
  questionCount    Int
  questionTypes    String[]           @default([])
  generationStartedAt DateTime?
  generationAttemptId String?
  generationStatus GenerationStatus   @default(pending)
  status           InterviewStatus    @default(draft)
  errorCode        String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  questions        Question[]
  sessions         Session[]
  usageLedger      UsageLedgerEntry[]

  @@index([userId, createdAt])
  @@index([resumeId])
  @@unique([id, userId])
}

model Question {
  id                String    @id @default(uuid()) @db.Uuid
  interviewId       String    @db.Uuid
  interview         Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  ordinal           Int
  category          String
  difficulty        String
  prompt            String
  expectedKeywords  String[]
  rubric            Json?
  generationVersion String
  createdAt         DateTime  @default(now())
  answers           Answer[]

  @@unique([interviewId, ordinal])
  @@unique([id, interviewId])
}

model Session {
  id                     String             @id @default(uuid()) @db.Uuid
  userId                 String             @db.Uuid
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  interviewId            String             @db.Uuid
  interview              Interview          @relation(fields: [interviewId, userId], references: [id, userId], onDelete: Cascade)
  status                 SessionStatus      @default(started)
  currentQuestionOrdinal Int                @default(0)
  startedAt              DateTime           @default(now())
  completedAt            DateTime?
  evaluationStartedAt    DateTime?
  durationSeconds        Int                @default(0)
  overallScore           Int?
  feedback               Json?
  evaluationJobId        String?            @unique @db.Uuid
  evaluationJob          BackgroundJob?     @relation("SessionEvaluation", fields: [evaluationJobId], references: [id], onDelete: SetNull)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  answers                Answer[]
  usageLedger            UsageLedgerEntry[]

  @@unique([id, interviewId])
  @@index([userId, createdAt])
  @@index([interviewId, status])
}

model Answer {
  id               String           @id @default(uuid()) @db.Uuid
  interviewId      String           @db.Uuid
  sessionId        String           @db.Uuid
  session          Session          @relation(fields: [sessionId, interviewId], references: [id, interviewId], onDelete: Cascade)
  questionId       String           @db.Uuid
  question         Question         @relation(fields: [questionId, interviewId], references: [id, interviewId], onDelete: Restrict)
  text             String
  questionText     String?
  answerAudio      String?
  followupUsed     Boolean          @default(false)
  skipped          Boolean          @default(false)
  timeTakenSeconds Int              @default(0)
  submittedAt      DateTime         @default(now())
  score            Int?
  feedback         String?
  evaluationStatus EvaluationStatus @default(pending)

  @@unique([sessionId, questionId])
  @@index([questionId])
}

model Plan {
  id              String          @id @default(uuid()) @db.Uuid
  code            String          @unique
  name            String
  description     String
  durationDays    Int             @default(30)
  credits         Int             @default(10)
  features        String[]        @default([])
  coupons         Json?
  directDiscount  Float           @default(0)
  isPublished     Boolean         @default(true)
  isArchived      Boolean         @default(false)
  postedById      String?         @db.Uuid
  postedBy        User?           @relation("PlanPoster", fields: [postedById], references: [id], onDelete: SetNull)
  billingInterval BillingInterval @default(one_time)
  currency        String          @default("INR")
  amountMinor     Int
  providerPriceId String?         @unique
  active          Boolean         @default(true)
  entitlements    Json
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  subscriptions   Subscription[]
  paymentOrders   PaymentOrder[]
  legacyTransactions LegacyTransaction[]
}

model BillingCustomer {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @unique @db.Uuid
  user               User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  provider           String
  providerCustomerId String   @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Subscription {
  id                     String             @id @default(uuid()) @db.Uuid
  userId                 String             @db.Uuid
  user                   User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  planId                 String             @db.Uuid
  plan                   Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  orderId                String?            @unique @db.Uuid
  order                  PaymentOrder?      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  providerSubscriptionId String?            @unique
  status                 SubscriptionStatus @default(active)
  creditLimit            Int
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  cancelAtPeriodEnd      Boolean            @default(false)
  canceledAt             DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([userId, status, currentPeriodEnd])
}

model PaymentOrder {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @db.Uuid
  user            User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  planId          String         @db.Uuid
  plan            Plan           @relation(fields: [planId], references: [id], onDelete: Restrict)
  transactionId   String         @unique
  idempotencyKey  String         @unique
  amountMinor     Int
  currency        String         @default("INR")
  creditLimit     Int
  durationDays    Int
  status          PaymentStatus  @default(pending)
  payuId          String?        @unique
  refundToken     String?        @unique
  refundRequestId String?        @unique
  productInfo     String?
  firstName       String?
  email           String?
  phone           String?
  callbackEmailTag String?
  callbackPhoneTag String?
  failureCode     String?
  lastReconciledAt DateTime?
  reconcileLeaseUntil DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  subscriptions   Subscription[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model PaymentEvent {
  id              String      @id @default(uuid()) @db.Uuid
  provider        String
  providerEventId String
  eventType       String
  receivedAt      DateTime    @default(now())
  processedAt     DateTime?
  status          EventStatus @default(received)
  error           String?
  payload         Json?

  @@unique([provider, providerEventId])
  @@index([status, receivedAt])
}

model UsageLedgerEntry {
  id             String     @id @default(uuid()) @db.Uuid
  userId         String     @db.Uuid
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId      String?    @db.Uuid
  session        Session?   @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  interviewId    String?    @db.Uuid
  interview      Interview? @relation(fields: [interviewId], references: [id], onDelete: SetNull)
  feature        String
  unitsDelta     Int
  periodKey      String
  reason         String
  status         String     @default("committed")
  idempotencyKey String     @unique
  createdAt      DateTime   @default(now())

  @@index([userId, feature, periodKey])
}

model BackgroundJob {
  id                String    @id @default(uuid()) @db.Uuid
  ownerUserId       String?   @db.Uuid
  owner             User?     @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  resourceType      String
  resourceId        String    @db.Uuid
  kind              String
  state             JobState  @default(queued)
  attempts          Int       @default(0)
  nextAttemptAt     DateTime?
  errorCode         String?
  payload           Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  evaluationSession Session?  @relation("SessionEvaluation")

  @@unique([resourceType, resourceId, kind])
  @@index([state, nextAttemptAt])
  @@index([ownerUserId, createdAt])
}

model JobSource {
  id        String       @id @default(uuid()) @db.Uuid
  name      String       @unique
  baseUrl   String?
  enabled   Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  listings  JobListing[]
  syncRuns  JobSyncRun[]
}

model JobListing {
  id          String    @id @default(uuid()) @db.Uuid
  sourceId    String    @db.Uuid
  source      JobSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  externalId  String
  title       String
  company     String
  location    String?
  description String
  salaryMin   Float?
  salaryMax   Float?
  category    String?   @default("General")
  contractType String?  @default("full_time")
  featured    Boolean   @default(false)
  pinned      Boolean   @default(false)
  archived    Boolean   @default(false)
  skills      String[] @default([])
  experience  String?   @default("Not Specified")
  jobHash     String?   @unique
  postedById  String?   @db.Uuid
  postedBy    User?     @relation("JobPoster", fields: [postedById], references: [id], onDelete: SetNull)
  applyUrl    String
  postedAt    DateTime?
  expiresAt   DateTime?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([sourceId, externalId])
  @@index([active, expiresAt, postedAt])
  @@index([category, contractType, location])
}

model JobSyncRun {
  id         String    @id @default(uuid()) @db.Uuid
  sourceId   String    @db.Uuid
  source     JobSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  status     JobState  @default(queued)
  fetched    Int       @default(0)
  inserted   Int       @default(0)
  updated    Int       @default(0)
  errorCode  String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([sourceId, startedAt])
}

model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @db.Uuid
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  category    String?
  status      String?  @default("success")
  details     String?
  targetType  String
  targetId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([targetType, targetId, createdAt])
}

model UsageCounter {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodKey String
  units     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, periodKey])
}

model LegacyTransaction {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  user          User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  planId        String?  @db.Uuid
  plan          Plan?    @relation(fields: [planId], references: [id], onDelete: SetNull)
  transactionId String   @unique
  amountMinor   Int
  currency      String
  status        String
  invoiceUrl    String?
  paymentMethod String?
  refundReason  String?
  refundedAt    DateTime?
  error         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, createdAt])
}

model InterviewTemplate {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  difficulty       String   @default("medium")
  duration         Int      @default(30)
  questionCount    Int      @default(5)
  systemPrompt     String
  evaluationPrompt String
  feedbackPrompt   String
  voiceId          String   @default("alloy")
  voiceSpeed       Float    @default(1)
  voicePitch       Float    @default(1)
  language         String   @default("en")
  postedById       String?  @db.Uuid
  postedBy         User?    @relation(fields: [postedById], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([postedById, createdAt])
}

model SystemPrompt {
  id              String   @id @default(uuid()) @db.Uuid
  category        String   @unique
  name            String
  content         String
  description     String   @default("")
  version         Int      @default(1)
  history         Json?
  lastUpdatedById String?  @db.Uuid
  lastUpdatedBy   User?    @relation("PromptEditor", fields: [lastUpdatedById], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SystemSetting {
  id           String   @id @default(uuid()) @db.Uuid
  singletonKey String   @unique @default("system")
  general      Json
  security     Json
  ai           Json
  storage      Json
  featureFlags Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ScraperConfig {
  id                String    @id @default(uuid()) @db.Uuid
  singletonKey      String    @unique @default("scraper")
  scrapeInterval    Int       @default(60)
  maxJobs           Int       @default(50)
  keywords          String[]  @default([])
  country           String    @default("us")
  remoteOnly        Boolean   @default(true)
  enabledSources    String[]  @default([])
  status            String    @default("idle")
  isActiveScheduler Boolean   @default(true)
  lastRun           DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model ScraperLog {
  id             String    @id @default(uuid()) @db.Uuid
  startTime      DateTime  @default(now())
  endTime        DateTime?
  status         String    @default("running")
  jobsImported   Int       @default(0)
  jobsUpdated    Int       @default(0)
  duplicateCount Int       @default(0)
  error          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([startTime])
}
